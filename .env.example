# LLM Provider Configuration: "mock" | "gemini" | "openai"
# When no API key is configured, the framework automatically uses the realistic Mock LLM.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Service Ports & URLs
SUT_PORT=3100
SUT_URL=http://127.0.0.1:3100
AI_PORT=8100
AI_SERVICE_URL=http://127.0.0.1:8100

# Execution Modes
LOCATOR_CHANGE=false
BUG_INJECTION=false
HEALING_ENABLED=true
HEALING_THRESHOLD=0.42
RUN_MODE=normal
